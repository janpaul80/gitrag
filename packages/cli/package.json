{
  "name": "@gitrag/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gitrag": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @gitrag/sanitizer build && tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gitrag/sanitizer": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
