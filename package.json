{
  "name": "gitrag",
  "version": "0.1.0",
  "private": true,
  "description": "GitRAG monorepo: an open-source repo oracle powered by Langdock.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @gitrag/web dev",
    "dev:server": "pnpm --filter @gitrag/server dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  }
}
